<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- ══════════════════════════════════════════════
         iisnode – proxy all requests to Express
    ══════════════════════════════════════════════ -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- ══════════════════════════════════════════════
         Security – block source / sensitive files
    ══════════════════════════════════════════════ -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="routes" />
          <add segment="middleware" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env"  allowed="false" />
          <add fileExtension=".sql"  allowed="false" />
          <add fileExtension=".log"  allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence=".." />
        </denyUrlSequences>
        <!-- Allow all HTTP verbs so Express can handle PUT, DELETE, PATCH -->
        <verbs allowUnlisted="true" />
      </requestFiltering>
    </security>

    <!-- ══════════════════════════════════════════════
         MIME types for modern assets
    ══════════════════════════════════════════════ -->
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff"  mimeType="font/woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg"   mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp"  mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json"  mimeType="application/json" />
    </staticContent>

    <!-- ══════════════════════════════════════════════
         HTTP Security Headers
    ══════════════════════════════════════════════ -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options"  value="nosniff" />
        <add name="X-Frame-Options"         value="SAMEORIGIN" />
        <add name="X-XSS-Protection"        value="1; mode=block" />
        <add name="Referrer-Policy"         value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"      value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <!-- ══════════════════════════════════════════════
         URL Rewrite Rules
    ══════════════════════════════════════════════ -->
    <rewrite>
      <rules>
        <clear />

        <!-- 1. Force HTTPS (production) -->
        <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^localhost" ignoreCase="true" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 2. Block direct access to server-side source files -->
        <rule name="Block source files" stopProcessing="true">
          <match url="^(server\.js|config\.js|db\.js|package(-lock)?\.json|schema\.sql|README\.md)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- 3. Pass everything else to Node.js / Express -->
        <rule name="Express catchall" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>

      </rules>
    </rewrite>

    <!-- ══════════════════════════════════════════════
         Compression
    ══════════════════════════════════════════════ -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- ══════════════════════════════════════════════
         iisnode configuration
    ══════════════════════════════════════════════ -->
    <iisnode
      nodeProcessCommandLine="node"
      watchedFiles="server.js;config.js;db.js;routes\*.js;middleware\*.js"
      loggingEnabled="true"
      logDirectory="iisnode_logs"
      debuggingEnabled="false"
      maxLogFileSizeInKB="128"
      maxTotalLogFileSizeInKB="1024"
      maxLogFiles="5"
      devErrorsEnabled="false"
    />

  </system.webServer>
</configuration>
