# ═══════════════════════════════════════════════
#  Cyber Dreams – Environment Template
#  Copy to .env and fill in real values
# ═══════════════════════════════════════════════

PORT=3000
NODE_ENV=production

# MySQL (external server – already running)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=cyber_dreams
DB_USER=root
DB_PASSWORD=

# Session secret – generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Admin panel password
ADMIN_PASSWORD=

# Set to true when serving over HTTPS
FORCE_SECURE_COOKIE=false

# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=https://cyberdreams.pk,http://localhost:3000
